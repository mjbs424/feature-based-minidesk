#!/usr/bin/env sh
set -e

staged_before=$(git diff --cached --name-only)
vp staged --hide-unstaged
staged_after=$(git diff --cached --name-only)
if [ "$staged_before" != "$staged_after" ]; then
  echo "vp staged changed the set of staged files. Review and restage before committing:" >&2
  git diff --cached --name-only >&2
  exit 1
fi

echo "Checking staged changes for secrets with Gitleaks..."
if ! command -v gitleaks >/dev/null 2>&1; then
  echo "Gitleaks is required for commits. Install it from https://github.com/gitleaks/gitleaks/releases and make sure gitleaks is on PATH." >&2
  exit 1
fi
gitleaks git --pre-commit --staged --redact

echo "Checking JavaScript and TypeScript for security findings with Semgrep..."
if ! command -v semgrep >/dev/null 2>&1; then
  echo "Semgrep is required for commits. Install Semgrep CLI and make sure semgrep is on PATH." >&2
  exit 1
fi
semgrep scan --config p/javascript --metrics off --error src .github/scripts

echo "Checking current changes with Fallow..."
fallow audit --base HEAD --gate all

echo "Checking staged files with React Doctor..."
react-doctor . --staged --scope files --yes --verbose --no-score --blocking error

if ! git diff --quiet -- package.json pnpm-lock.yaml pnpm-workspace.yaml .github/audit-exceptions.json; then
  echo "Stage dependency and audit exception changes before committing" >&2
  exit 1
fi

echo "Checking dependencies with pnpm audit..."
node .github/scripts/security-audit.mjs
